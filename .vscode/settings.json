{
    "code-runner.runInTerminal": true,
    "code-runner.executorMap": {
        "python":"zsh -c 'set -a && source $workspaceRoot/.env && exec $workspaceRoot/.venv/bin/python -u $fullFileName'"
    },
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
    },
    "search.exclude": {
        "**/.git": true,
        "**/.vscode": true,
        "**/__pycache__": true,
        "**/output": true,
        "**/log": true,
        ".datasets": true,
        ".storage": true,
        "**/.venv/**": true
    },
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/.hg/store/**": true,
        "**/.venv/**": true,
        "**/__pycache__/**": true,
        ".datasets/**": true,
        ".storage/**": true,
    },
    "python.analysis.exclude": [
        "**/.git",
        "**/.vscode",
        "**/__pycache__",
        "**/output",
        "**/log",
        "**/.venv",
        ".datasets",
        ".storage",
        ".github",
        ".server",
        "docs",
        "logs",
        "nginx",
        "out"
    ],
    "python.analysis.extraPaths": [
        "./modules/sjpy",
        "./modules/sjaipy",
        "./modules/LID",
        "./modules/LID/modules/LIA",
    ],
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.envFile": "${workspaceFolder}/.env",
    "jupyter.notebookFileRoot": "${workspaceFolder}",
    // Editor
    "editor.wordWrap": "on",
    "editor.wrappingIndent": "indent",
    "editor.fontFamily": "JetBrains Mono, D2Coding",
    "editor.fontLigatures": true,
    "editor.fontSize": 18,
    "editor.letterSpacing": 0,
    "editor.detectIndentation": false,
    "editor.trimAutoWhitespace": true,
    "terminal.integrated.fontFamily": "JetBrains Mono, D2Coding",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.eol": "\n",
    // Formatter
    "editor.formatOnSave": true,
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter"
    },
    "[markdown]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[plantuml]": {
        "editor.defaultFormatter": "jebbs.plantuml"
    },
    "cSpell.words": [
        "afut",
        "ASRUC",
        "cpus",
        "diarizer",
        "Diarizing",
        "dotenv",
        "embbeding",
        "frombuffer",
        "genai",
        "generativeai",
        "itemsize",
        "LLMUC",
        "ndarray",
        "packb",
        "pyannote",
        "reinit",
        "sjpy",
        "tobytes",
        "uids",
        "unpackb",
        "usecase"
    ],
}
