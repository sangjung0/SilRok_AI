{
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "code-runner.runInTerminal": true,
    "code-runner.executorMap": {
        "python":"zsh -c 'set -a && source $workspaceRoot/.env && exec $workspaceRoot/.venv/bin/python -u $fullFileName'"
    },
    "editor.wordWrap": "on",
    "editor.wrappingIndent": "indent",
    "jupyter.notebookFileRoot": "${workspaceFolder}",
    "python.envFile": "${workspaceFolder}/.env",
    "python.analysis.exclude": [
        "**/__pycache__",
        "**/.git",
        ".venv",
        ".devcontainer",
        ".vscode",
        ".github",
        ".idea",
        ".server",
        ".model",
        "docs",
        "logs",
        "nginx",
        "out"
    ],
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/.hg/store/**": true,
    },
    "cSpell.words": [
        "afut",
        "ASRUC",
        "cpus",
        "Diarizing",
        "dotenv",
        "embbeding",
        "frombuffer",
        "genai",
        "generativeai",
        "LLMUC",
        "ndarray",
        "packb",
        "pyannote",
        "reinit",
        "tobytes",
        "unpackb",
        "usecase"
    ],
    // Editor
    "editor.fontFamily": "JetBrains Mono, D2Coding",
    "editor.fontLigatures": true,
    "editor.fontSize": 18,
    "editor.letterSpacing": 0,
    "editor.detectIndentation": false,
    "editor.trimAutoWhitespace": true,
    "terminal.integrated.fontFamily": "JetBrains Mono, D2Coding",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.eol": "\n",
    // Formatter
    "editor.formatOnSave": true,
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter"
    },
    "[markdown]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[plantuml]": {
        "editor.defaultFormatter": "jebbs.plantuml"
    }
}
