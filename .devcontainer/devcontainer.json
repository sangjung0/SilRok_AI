{
    "name": "SilRok_dev",
    "dockerComposeFile": "./docker-compose.yml",
    "service": "service",
    "workspaceFolder": "/workspaces/silrok",
    "postCreateCommand": "bash ${CONTAINER_WORK_DIR}/.devcontainer/sjsh/sync_uv.sh ${CONTAINER_WORK_DIR} ${CONTAINER_HOME} ${CONTAINER_UV_GROUP}",

    // for linux container
    // "initializeCommand": "[ ! -d ${localWorkspaceFolder}/.devcontainer/sjsh ] && git clone --branch LID https://github.com/sangjung0/sjsh.git ${localWorkspaceFolder}/.devcontainer/sjsh || true",

    // for windows container
    "initializeCommand": "cd /d ${localWorkspaceFolder} && if not exist .devcontainer/sjsh git clone --branch LID https://github.com/sangjung0/sjsh.git .devcontainer/sjsh",

    "features": {
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.vscode-pylance",
                "ms-python.python",
                "ms-python.debugpy",
                "rsip-vision.nvidia-smi-plus",
                "ms-vscode.azurecli",
                "esbenp.prettier-vscode",
                "ms-toolsai.jupyter",
                "njpwerner.autodocstri",
                "formulahendry.code-runner",
                "streetsidesoftware.code-spell-checker",
                "naumovs.color-highlight",
                "oderwat.indent-rainbow",
                "ionutvmi.path-autocomplete",
                "mgesbert.python-path",
                "foxundermoon.shell-format",
                "gruntfuggly.todo-tree",
                "editorconfig.editorconfig",
                "ms-python.black-formatter",
                "jebbs.plantuml",
                "claudineyqr.plantuml-snippets"
            ]
        }
    }
}
